		<td><a href="http://wordpress.org/download/">WordPress</a></td>
		<td><a href="http://secunia.com/advisories/search/?search=WordPress">Security Advisories</a></td>
	</tr>
	<tr>
		<td><input type="checkbox"></td>
		<td><a href="http://www.xoops.org/">Xoops</a></td>
		<td><a href="http://secunia.com/advisories/search/?search=Xoops">Security Advisories</a></td>
	</tr>
